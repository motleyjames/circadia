{
  "name": "circadia",
  "version": "0.8.14",
  "private": true,
  "license": "UNLICENSED",
  "author": "James Motley",
  "description": "Local-first sleep companion for people who cannot fall asleep, cannot stay asleep, or both.",
  "repository": {
    "type": "git",
    "url": "https://github.com/motleyjames/circadia.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 43147 --hostname 127.0.0.1",
    "mod": "node electron/run-mod.cjs",
    "build": "next build",
    "start": "next start --port 43147 --hostname 127.0.0.1",
    "app": "node electron/dev.cjs",
    "dock": "node electron/install-both-native.cjs",
    "dock:mod": "node electron/install-both-native.cjs --operator",
    "dock:diary": "node electron/install-both-native.cjs --diary",
    "dock:all": "node electron/install-both-native.cjs",
    "put-on-dock": "bash scripts/put-on-dock.sh",
    "dock-update": "node electron/dock-update.cjs",
    "fix-mac": "node electron/fix-mac.cjs",
    "repair": "node electron/fix-mac.cjs",
    "reveal": "node electron/install-mac.cjs --reveal",
    "reveal:mod": "node electron/install-mac.cjs --operator --reveal",
    "dist": "node electron/build-ui.cjs && electron-builder --mac dir zip --publish never",
    "lint": "eslint",
    "test": "vitest run --exclude src/lib/static-surface.test.ts && vitest run src/lib/static-surface.test.ts",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "pack:static": "node electron/build-ui.cjs",
    "phone:sync": "npm run pack:static && node scripts/pack-mac-diary.cjs && npm --prefix phone install && npm --prefix phone run sync",
    "phone:open": "npm --prefix phone run open",
    "put-on-phone": "bash scripts/put-on-phone.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "app.circadia.desktop",
    "productName": "Circadia",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "ui"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "electron/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Circadia",
        "CFBundleName": "Circadia",
        "NSHighResolutionCapable": true
      },
      "target": [
        "dir",
        "zip"
      ]
    }
  }
}
