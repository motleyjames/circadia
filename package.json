{
  "name": "circadia",
  "version": "0.5.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 43147 --hostname 127.0.0.1",
    "mod": "node electron/run-mod.cjs",
    "build": "next build",
    "start": "next start --port 43147 --hostname 127.0.0.1",
    "app": "node electron/dev.cjs",
    "dock": "node electron/repair-app.cjs && node electron/install-mac.cjs && node electron/install-mac.cjs --operator",
    "dock:mod": "node electron/install-mac.cjs --operator",
    "repair": "node electron/repair-app.cjs",
    "reveal": "node electron/install-mac.cjs --reveal",
    "reveal:mod": "node electron/install-mac.cjs --operator --reveal",
    "dist": "node electron/build-ui.cjs && electron-builder --mac dir zip --publish never",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "app.circadia.desktop",
    "productName": "Circadia",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "ui"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "electron/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Circadia",
        "CFBundleName": "Circadia",
        "NSHighResolutionCapable": true
      },
      "target": [
        "dir",
        "zip"
      ]
    }
  }
}
