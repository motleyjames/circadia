# Local Circadia. Copy to .env.local if you want.

# Operator console at /mod. Change this.
CIRCADIA_MOD_KEY=circadia-local

# Do not set CIRCADIA_ELECTRON, CIRCADIA_PACK_STATIC, or NEXT_PUBLIC_CIRCADIA_PHONE_PACK here.
# Those used to flip Next into static export and compiled the CSS open out of Circadia.app.

# Only needed so testers on other machines can reach your inbox.
# STUDY_INGEST_URL=
# STUDY_INGEST_TOKEN=
