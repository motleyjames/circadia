                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" red="0.019607843137254902" green="0.015686274509803921" blue="0.0392156862745098" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </view>
