# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-mod/
/out/
/public/circadia-locked.json
/circadia-locked.json

# production
/dist
/build
/release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anonymous study packs land here locally — never commit them
/data/study-inbox/*
!/data/study-inbox/.gitkeep
/data/vault.json
/data/fold-inbox.circadia
/data/vault/
/.circadia-update.lock
/src/app/.api-parked
/.api-parked
/.mod-parked

# Capacitor audio spike. Parked locally; not part of Circadia.app.
/spikes/
/src/lib/ios-audio-spike.test.ts
/spikes/ios-audio/node_modules
/spikes/ios-audio/dist
/spikes/ios-audio/ios/App/Pods
/spikes/ios-audio/ios/App/App/public
/spikes/ios-audio/ios/DerivedData
/spikes/ios-audio/ios/App/App.xcodeproj/xcuserdata
/spikes/ios-audio/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata

# iPhone diary shell (Capacitor). Commit the Xcode project; ignore CocoaPods and synced web assets.
/phone/node_modules
/phone/ios/App/Pods
/phone/ios/App/App/public
/phone/ios/DerivedData
/phone/ios/.pack-stamp
/phone/ios/signing.xcconfig
/phone/ios/App/App.xcodeproj/xcuserdata
/phone/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata
/phone/ios/App/App.xcworkspace/xcuserdata
