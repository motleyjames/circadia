# Meeseeks AI Model API Keys
# Copy this file to API_CONFIG.env and fill in your keys
# cp API_CONFIG.env.example API_CONFIG.env

# Anthropic — required for Claude council votes + code review
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Google Gemini — required for council votes + vision
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_KEY_HERE

# OpenAI — required for council votes + GPT models
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# Hugging Face — optional, for downloading gated models (Z-Image-Turbo, Flux, etc.)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE

# FAL AI — optional, for cloud generative media
# Get yours at: https://fal.ai/dashboard/keys
FAL_KEY=YOUR_KEY_HERE
