          "name": "execute",
          "delegate_to": "opencode",
          "input": "plan",
          "output": "result"
        },
        {
          "name": "reflect",
          "model_selection": {
            "judge_for": "execute.model",
            "prefer_different_provider": true
          },
          "input": [
            "plan",
            "result"
          ],
          "output": "reflection"
        }
      ],
      "on_low_score": {
        "threshold": 70,
        "action": "trigger_improvement"
      },
      "on_failure": {
        "action": "retry_with_fallback",
        "max_retries": 2
      }
    },
    "recursive_refinement": {
      "description": "Generate -> Critique -> Refine loop until convergence",
      "max_iterations": 5,
      "stages": [
        {
          "name": "generate",
          "model": "claude-sonnet-4-6",
          "output": "draft"
        },
        {
          "name": "critique",
          "model": "o3",
          "different_provider": true,
          "input": "draft",
          "output": "critique"
        },
        {
          "name": "refine",
          "model": "claude-opus-4-6",
          "input": [
            "draft",
            "critique"
          ],
          "output": "refined"
        },
        {
          "name": "judge",
          "model": "gpt-5.2-pro",
          "input": [
            "draft",
            "refined"
          ],
          "output": "score"
        }
      ],
      "convergence": {
        "metric": "score",
        "threshold": 0.95,
        "or_no_improvement_for": 2
      }
    },
    "council_decision": {
      "description": "Multi-model voting for critical decisions",
      "stages": [
        {
          "name": "gather_opinions",
          "parallel": true,
          "models": [
            "claude-opus-4-6",
            "gpt-5.3-codex",
            "gemini-3.1-pro-preview"
          ],
          "input": "question",
          "output": "opinions"
        },
        {
          "name": "synthesize",
          "model": "claude-opus-4-6",
          "input": "opinions",
          "output": "synthesis"
        },
        {
          "name": "arbiter_decision",
          "model": "gpt-5.2-pro",
          "input": [
            "question",
            "opinions",
            "synthesis"
          ],
          "output": "final_decision",
          "on_deadlock": "use_arbiter"
        }
      ]
    }
  },
