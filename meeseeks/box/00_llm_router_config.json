  "pipelines": {
    "_comment": "IMPROVEMENT 2: Explicit multi-stage pipelines with model assignments",
    "think_plan_execute_reflect": {
      "description": "Standard goal execution pipeline",
      "stages": [
        {
          "name": "think",
          "model_selection": {
            "task_type": "reasoning",
            "budget": "quality"
          },
          "output": "reasoning"
