# Gen-Media SDK Configuration
# Copy this file to .env and customize paths for your setup

# =============================================================================
# PATHS
# =============================================================================

# ComfyUI installation directory (where main.py lives)
# Default: ~/ComfyUI
COMFYUI_PATH=

# Shared models directory (checkpoints, text_encoders, vae, etc.)
# Default: $COMFYUI_PATH/models
MODELS_PATH=

# Output directory for generated images
# Default: ./output
OUTPUT_PATH=

# Workflows directory (JSON workflow templates)
# Default: ./workflows
WORKFLOWS_PATH=

# =============================================================================
# SERVERS
# =============================================================================

# ComfyUI server URL
# Default: http://127.0.0.1:8188
COMFYUI_URL=

# Draw Things API URL (when running with API enabled)
# Default: http://127.0.0.1:7860
DRAWTHINGS_URL=

# =============================================================================
# GENERATION DEFAULTS
# =============================================================================

# Default image dimensions
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=768

# Default inference steps
DEFAULT_STEPS=4

# Default guidance scale
DEFAULT_CFG=7.5

# Default backend: comfyui | mflux | drawthings
DEFAULT_BACKEND=comfyui

